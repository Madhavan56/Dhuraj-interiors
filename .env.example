# Copy to .env and adjust. Never commit the real .env.

# Admin sign-in. ADMIN_PASSWORD is applied on every restart, so changing it here
# changes the password. Leave it out to keep the current one.
ADMIN_EMAIL=dhurajinteriors16@gmail.com
ADMIN_PASSWORD=choose-a-strong-password

# Web server port (Vite proxies /api and /uploads here during development).
PORT=4000

# Where the local SQLite database and uploaded images live (development only).
DATA_DIR=data

# Hosted SQLite (Turso). Leave both blank to use data/dhuraj.sqlite locally.
# Create a database with: turso db create dhuraj-interiors
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob token for project photos. Leave blank to write to data/uploads.
BLOB_READ_WRITE_TOKEN=

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false
